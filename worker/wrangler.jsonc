{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "r2notary",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",

  // Placeholders only: no account IDs, real bucket names or secrets belong here.
  // Secrets: `.dev.vars` locally (`npm run keygen`), `wrangler secret put` remotely
  // (docs/OPERATIONS.md). READ_TOKEN is only used when PUBLIC_LOG is "false" (the default).
  // ALERT_WEBHOOK_URL (https, optional) is not listed: `required` is the only kind wrangler has.
  // KEY_BLINDING_KEY is only used when KEY_BLINDING is "true" (M8); like READ_TOKEN, a listed secret
  // that is not set only produces a local warning.
  "secrets": { "required": ["SIGNING_KEY", "ADMIN_TOKEN", "READ_TOKEN", "KEY_BLINDING_KEY"] },

  "exports": {
    "Sequencer": { "type": "durable-object", "storage": "sqlite" },
  },
  "durable_objects": {
    "bindings": [{ "name": "SEQUENCER", "class_name": "Sequencer" }],
  },
  "r2_buckets": [
    { "binding": "MONITORED", "bucket_name": "example-monitored-bucket" },
    { "binding": "LOG", "bucket_name": "example-log-bucket" },
  ],
  // The consumer acks a batch once the Sequencer has it, and retries it with backoff otherwise
  // (worker/src/ingest.ts). After max_retries a message moves to the dead-letter queue, which this
  // Worker also consumes: one more attempt to log it, and a count in /status. The DLQ has no DLQ of
  // its own, so a message that fails there too is dropped; the auditor is the backstop.
  "queues": {
    "consumers": [
      {
        "queue": "r2notary-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "r2notary-events-dlq",
      },
      {
        "queue": "r2notary-events-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5,
      },
    ],
  },
  // The auditor (worker/src/audit/). The cron starts an audit every 6 hours unless one is running;
  // POST /api/v1/admin/{scan,backfill} start one by hand.
  "workflows": [
    { "binding": "SCAN_WORKFLOW", "name": "r2notary-scan", "class_name": "ScanWorkflow" },
  ],
  "triggers": { "crons": ["0 */6 * * *"] },

  // The in-browser verifier (M8, dashboard/): static files served by Workers Static Assets at
  // `/`. Asset requests do not run the Worker; the log and API always do, so no file can shadow
  // them. The bundle is built before `wrangler dev` and `wrangler deploy`.
  "assets": {
    "directory": "../dashboard/public",
    "not_found_handling": "none",
    "run_worker_first": ["/log/*", "/api/*"],
  },
  // `build.cwd` is resolved against wrangler's working directory, not this file's, so the command
  // must work from anywhere in the repo; npm finds the workspace root itself. (`watch_dir` is
  // resolved against this file.)
  "build": {
    "command": "npm run build --workspace=@r2notary/dashboard",
    "watch_dir": "../dashboard/src",
  },

  "vars": {
    "LOG_NAME": "example-log",
    // The log's URL prefix without the scheme or a trailing slash (C2SP tlog-tiles SHOULD):
    // this Worker serves the log at https://<host>/log/<LOG_NAME>/.
    "LOG_ORIGIN": "r2notary.example.com/log/example-log",
    "MONITORED_BUCKET_NAME": "example-monitored-bucket",
    "LOG_BUCKET_NAME": "example-log-bucket",
    "CHECKPOINT_INTERVAL_MS": "5000",
    "BATCH_MAX_ENTRIES": "500",
    "DEDUPE_TTL_SECONDS": "86400",
    // must match the dead_letter_queue above
    "EVENTS_DLQ_NAME": "r2notary-events-dlq",
    // How long a divergence must stay unexplained by an event before it is a finding.
    "AUDIT_GRACE_SECONDS": "300",
    // Deep scrub reads object bodies (billed reads, CPU): off unless set, e.g. "0.01".
    "DEEP_SCRUB_SAMPLE_RATE": "0",
    "DEEP_SCRUB_MAX_BYTES": "104857600",
    "PUBLIC_LOG": "false",
    // Witnesses (C2SP tlog-witness, M8): a JSON array of {"vkey": "<cosigner vkey>", "url":
    // "https://<submission prefix>"}. Each checkpoint is submitted to every witness before it is
    // published, and needs WITNESS_QUORUM cosignatures (0: publish with whatever was collected).
    "WITNESSES": "[]",
    "WITNESS_QUORUM": "0",
    // Key blinding (M8): log HMAC-SHA256(KEY_BLINDING_KEY, key) instead of object keys, so a public
    // log does not disclose key names. Decide before the first entry: the Sequencer refuses to
    // change it for an existing log.
    "KEY_BLINDING": "false",
  },
}
