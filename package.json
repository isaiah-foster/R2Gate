{
  "name": "r2notary-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "worker",
    "witness",
    "dashboard"
  ],
  "scripts": {
    "test": "vitest run",
    "build:dashboard": "npm run build -w @r2notary/dashboard",
    "test:contract:remote": "vitest run --config worker/vitest.remote.config.ts",
    "dev:sim": "wrangler dev -c worker/dev/wrangler.simulator.jsonc -c worker/wrangler.jsonc --persist-to .wrangler/state",
    "simulate": "node scripts/simulate-events.ts",
    "keygen": "node scripts/keygen.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conformance": "node scripts/conformance.ts",
    "bench:hashing": "node bench/hashing.ts",
    "bench:proofs": "node bench/proofs.ts",
    "bench:amplification": "node bench/amplification.ts",
    "bench:cost": "node bench/cost.ts",
    "bench:sequencer": "node bench/sequencer.ts",
    "bench:latency": "node bench/latency.ts",
    "bench:auditor": "node bench/auditor.ts",
    "bench": "npm run bench:hashing && npm run bench:proofs && npm run bench:amplification && npm run bench:cost && npm run bench:sequencer && npm run bench:latency && npm run bench:auditor"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
