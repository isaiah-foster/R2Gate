{
  "name": "r2notary-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "scripts": {
    "test": "vitest run",
    "test:contract:remote": "vitest run --config worker/vitest.remote.config.ts",
    "dev:sim": "wrangler dev -c worker/dev/wrangler.simulator.jsonc -c worker/wrangler.jsonc",
    "simulate": "node scripts/simulate-events.ts",
    "keygen": "node scripts/keygen.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conformance": "node scripts/conformance.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
